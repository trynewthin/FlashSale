# ── 资源档位：high（适用于 8C/16G+） ──
FLASH_PROFILE=high

# MySQL
FLASH_MYSQL_INNODB_BUFFER_POOL=2G
FLASH_MYSQL_MAX_CONNECTIONS=200
FLASH_MYSQL_MEM_LIMIT=3072m

# Redis
FLASH_REDIS_MAXMEMORY=1gb
FLASH_REDIS_MEM_LIMIT=1536m

# Kafka (JVM)
FLASH_KAFKA_HEAP_OPTS=-Xmx1G -Xms512M
FLASH_KAFKA_MEM_LIMIT=1536m

# etcd
FLASH_ETCD_MEM_LIMIT=512m

# Go 微服务（每个实例）
FLASH_GO_SVC_MEM_LIMIT=256m

# Nginx / CDN / media-store
FLASH_NGINX_MEM_LIMIT=256m
FLASH_CDN_MEM_LIMIT=128m
FLASH_MEDIA_STORE_MEM_LIMIT=256m

# Ops 控制台
FLASH_OPS_MEM_LIMIT=384m

# 可观测性
FLASH_JAEGER_MEM_LIMIT=1024m
FLASH_PROMETHEUS_MEM_LIMIT=1024m
FLASH_GRAFANA_MEM_LIMIT=512m
