    "panels": [
        {
            "title": "RPC 请求速率 (req/s)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "fillOpacity": 10,
                        "lineWidth": 2
                    },
                    "unit": "reqps"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "sum(rate(rpc_server_requests_duration_ms_count[1m])) by (job)",
                    "legendFormat": "{{job}}",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "RPC P99 延迟 (ms)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "fillOpacity": 10,
                        "lineWidth": 2
                    },
                    "unit": "ms"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.99, sum(rate(rpc_server_requests_duration_ms_bucket[1m])) by (le, job))",
