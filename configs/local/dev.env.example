# Docker host ports (change here if ports are occupied)
FLASH_MYSQL_PORT=13306
FLASH_REDIS_PORT=16379
FLASH_KAFKA_PORT=39092
FLASH_NGINX_HTTP_PORT=18000
FLASH_JAEGER_UI_PORT=16686
FLASH_OTEL_PORT=4317
FLASH_PROMETHEUS_PORT=9090
FLASH_GRAFANA_PORT=3000

# Container credentials
FLASH_MYSQL_ROOT_PASSWORD=replace_me
FLASH_MYSQL_APP_USER=flash
FLASH_MYSQL_APP_PASSWORD=replace_me
FLASH_GRAFANA_ADMIN_USER=admin
FLASH_GRAFANA_ADMIN_PASSWORD=replace_me

# Application connection overrides (loaded by dev scripts)
FLASHSALE_MYSQL_HOST=127.0.0.1
FLASHSALE_MYSQL_PORT=13306
FLASHSALE_MYSQL_USER=flash
FLASHSALE_MYSQL_PASSWORD=replace_me
FLASHSALE_REDIS_ADDR=127.0.0.1:16379
FLASHSALE_KAFKA_BROKERS=127.0.0.1:39092

# Ops control access key (for remote Web/CLI access)
FLASHSALE_OPS_ACCESS_KEY=replace_me_strong_key
