# FlashSale 后端全容器化（docker-compose.app.yml）可选环境变量示例
#
# 说明：
# - docker compose 会自动读取项目根目录的 .env；你也可以用 --env-file 指定
# - 本文件仅作为可提交模板，不包含真实密钥

# MySQL 容器初始化
FLASH_MYSQL_ROOT_PASSWORD=flashsale_root_dev
FLASH_MYSQL_APP_USER=flash
FLASH_MYSQL_APP_PASSWORD=flashsale_app_dev

# 对外暴露的 Nginx 端口（HTTP）
FLASH_NGINX_HTTP_PORT=18000

# JWT 密钥（演示环境可用默认值；如需远程部署请务必替换）
FLASHSALE_JWT_USER_SECRET=user-secret-change-me
FLASHSALE_JWT_ADMIN_SECRET=admin-secret-change-me

