# ── 资源档位：low（适用于 2C/4G ~ 4C/4G） ──
FLASH_PROFILE=low

# MySQL
FLASH_MYSQL_INNODB_BUFFER_POOL=128M
FLASH_MYSQL_MAX_CONNECTIONS=50
FLASH_MYSQL_MEM_LIMIT=512m

# Redis
FLASH_REDIS_MAXMEMORY=128mb
FLASH_REDIS_MEM_LIMIT=192m

# Kafka (JVM)
FLASH_KAFKA_HEAP_OPTS=-Xmx256M -Xms128M
FLASH_KAFKA_MEM_LIMIT=512m

# etcd
FLASH_ETCD_MEM_LIMIT=128m

# Go 微服务（每个实例）
FLASH_GO_SVC_MEM_LIMIT=64m

# Nginx / CDN / media-store
FLASH_NGINX_MEM_LIMIT=64m
FLASH_CDN_MEM_LIMIT=32m
FLASH_MEDIA_STORE_MEM_LIMIT=64m

# Ops 控制台
FLASH_OPS_MEM_LIMIT=96m

# 可观测性
FLASH_JAEGER_MEM_LIMIT=256m
FLASH_PROMETHEUS_MEM_LIMIT=256m
FLASH_GRAFANA_MEM_LIMIT=128m
