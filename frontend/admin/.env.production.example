# Vercel Serverless API proxy target (no trailing slash)
BACKEND_ORIGIN=https://your-backend-domain.example.com

# Keep default to use same-origin /api/v1/admin via Vercel proxy
# VITE_ADMIN_API_BASE_URL=/api/v1/admin

# CDN 静态资源地址（图片前缀），生产环境改为公网 CDN
VITE_CDN_BASE_URL=https://your-cdn-domain.example.com
