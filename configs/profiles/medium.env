# ── 资源档位：medium（适用于 4C/8G） ──
FLASH_PROFILE=medium

# MySQL
FLASH_MYSQL_INNODB_BUFFER_POOL=512M
FLASH_MYSQL_MAX_CONNECTIONS=100
FLASH_MYSQL_MEM_LIMIT=1024m

# Redis
FLASH_REDIS_MAXMEMORY=256mb
FLASH_REDIS_MEM_LIMIT=384m

# Kafka (JVM)
FLASH_KAFKA_HEAP_OPTS=-Xmx512M -Xms256M
FLASH_KAFKA_MEM_LIMIT=768m

# etcd
FLASH_ETCD_MEM_LIMIT=256m

# Go 微服务（每个实例）
FLASH_GO_SVC_MEM_LIMIT=128m

# Nginx / CDN / media-store
FLASH_NGINX_MEM_LIMIT=128m
FLASH_CDN_MEM_LIMIT=64m
FLASH_MEDIA_STORE_MEM_LIMIT=128m

# Ops 控制台
FLASH_OPS_MEM_LIMIT=192m

# 可观测性
FLASH_JAEGER_MEM_LIMIT=512m
FLASH_PROMETHEUS_MEM_LIMIT=512m
FLASH_GRAFANA_MEM_LIMIT=256m
