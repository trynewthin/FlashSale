# deploy.env — FlashSale 部署配置（单一配置源，参与版本控制）
#
# 所有凭据、端口映射、服务地址统一在此定义。
# 地址使用 Docker 内部 service name，compose 和容器内任务直接读取。

# ── Docker 宿主机端口映射 ──
FLASH_MYSQL_PORT=13306
FLASH_REDIS_PORT=16379
FLASH_KAFKA_PORT=39092
FLASH_JAEGER_UI_PORT=16686
FLASH_OTEL_PORT=4317
FLASH_PROMETHEUS_PORT=9090
FLASH_GRAFANA_PORT=3000
FLASH_OPS_PORT=9100
FLASH_CDN_PORT=19000
FLASH_MEDIA_STORE_PORT=19001
FLASH_NGINX_HTTP_PORT=18000

# ── 容器凭据 ──
FLASH_MYSQL_ROOT_PASSWORD=root123
FLASH_MYSQL_APP_USER=flash
FLASH_MYSQL_APP_PASSWORD=flash123
FLASH_GRAFANA_ADMIN_USER=admin
FLASH_GRAFANA_ADMIN_PASSWORD=admin
FLASH_MEDIA_STORE_SECRET=flashsale-media-dev

# ── 应用连接地址（Docker 内部网络） ──
FLASHSALE_MYSQL_HOST=mysql
FLASHSALE_MYSQL_PORT=3306
FLASHSALE_MYSQL_USER=flash
FLASHSALE_MYSQL_PASSWORD=flash123
FLASHSALE_REDIS_ADDR=redis:6379
FLASHSALE_KAFKA_BROKERS=kafka:9092

# ── JWT Secrets ──
FLASHSALE_JWT_USER_SECRET=user-secret-change-me
FLASHSALE_JWT_ADMIN_SECRET=admin-secret-change-me

# ── Ops 控制台 ──
FLASHSALE_OPS_ACCESS_KEY=flashsale_ops_2026
