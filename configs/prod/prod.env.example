# FlashSale Production Environment Template (Committable)
#
# 用法：
# 1) 复制为 configs/prod/prod.env（该文件已在 .gitignore 中）
# 2) 按实际环境填写敏感值
# 3) 启动时通过 --env-file 指向该文件

# ------------------------------------------------------------------
# Docker 基础依赖（compose 读取）
# ------------------------------------------------------------------
FLASH_MYSQL_ROOT_PASSWORD=replace_mysql_root_password
FLASH_MYSQL_APP_USER=flash
FLASH_MYSQL_APP_PASSWORD=replace_mysql_app_password

# 可选：宿主机映射端口（不填则走 compose 默认值）
FLASH_MYSQL_PORT=13306
FLASH_REDIS_PORT=16379
FLASH_KAFKA_PORT=39092
FLASH_NGINX_HTTP_PORT=18000

# ------------------------------------------------------------------
# 后端服务连接覆盖（应用读取，前缀必须为 FLASHSALE）
# 当前项目默认是“依赖容器化 + Go 服务宿主机进程化”，
# 因此示例值按宿主机访问容器端口给出。
# ------------------------------------------------------------------
FLASHSALE_MYSQL_HOST=127.0.0.1
FLASHSALE_MYSQL_PORT=13306
FLASHSALE_MYSQL_USER=flash
FLASHSALE_MYSQL_PASSWORD=replace_mysql_app_password
FLASHSALE_REDIS_ADDR=127.0.0.1:16379
FLASHSALE_KAFKA_BROKERS=127.0.0.1:39092

# JWT 密钥（正确键名：FLASHSALE_JWT_*）
FLASHSALE_JWT_USER_SECRET=replace_user_jwt_secret_64_plus
FLASHSALE_JWT_ADMIN_SECRET=replace_admin_jwt_secret_64_plus

# ------------------------------------------------------------------
# RPC 目标覆盖（宿主机进程化默认值）
# 说明：SECKILL 拼写与当前代码保持一致（非 typo bug）。
# ------------------------------------------------------------------
FLASHSALE_USER_GATEWAY_USER_RPC_TARGET=127.0.0.1:8081
FLASHSALE_USER_GATEWAY_PRODUCT_RPC_TARGET=127.0.0.1:8084
FLASHSALE_USER_GATEWAY_ORDER_RPC_TARGET=127.0.0.1:8085
FLASHSALE_USER_GATEWAY_SECKILL_RPC_TARGET=127.0.0.1:8086

FLASHSALE_ADMIN_GATEWAY_USER_RPC_TARGET=127.0.0.1:8081
FLASHSALE_ADMIN_GATEWAY_ADMIN_RPC_TARGET=127.0.0.1:8087
FLASHSALE_ADMIN_GATEWAY_PRODUCT_RPC_TARGET=127.0.0.1:8084
FLASHSALE_ADMIN_GATEWAY_ORDER_RPC_TARGET=127.0.0.1:8085
FLASHSALE_ADMIN_GATEWAY_SECKILL_RPC_TARGET=127.0.0.1:8086

FLASHSALE_ORDER_PRODUCT_RPC_TARGET=127.0.0.1:8084
FLASHSALE_SECKILL_PRODUCT_RPC_TARGET=127.0.0.1:8084
FLASHSALE_SECKILL_ORDER_RPC_TARGET=127.0.0.1:8085

# 可选：ops-control 访问密钥
FLASHSALE_OPS_ACCESS_KEY=replace_ops_access_key
